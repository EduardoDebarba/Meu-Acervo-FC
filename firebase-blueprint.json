{
  "entities": {
    "Shirt": {
      "title": "Shirt",
      "description": "A football shirt in the collection",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "team": { "type": "string" },
        "season": { "type": "string" },
        "type": { "type": "string" },
        "brand": { "type": "string" },
        "size": { "type": "string" },
        "condition": { "type": "string" },
        "price": { "type": "number" },
        "purchaseDate": { "type": "string" },
        "purchaseLocation": { "type": "string" },
        "authenticityTag": { "type": "string" },
        "autographed": { "type": "boolean" },
        "autographDetails": { "type": "string" },
        "isCustomized": { "type": "boolean" },
        "customizationDetails": { "type": "string" },
        "notes": { "type": "string" },
        "imageUrls": {
          "type": "array",
          "items": { "type": "string" }
        },
        "imageBgColor": { "type": "string" },
        "isFavorite": { "type": "boolean" },
        "createdAt": { "type": "number" }
      },
      "required": ["userId", "team", "season", "type", "brand", "size", "condition", "price", "createdAt"]
    },
    "WishlistShirt": {
      "title": "WishlistShirt",
      "description": "A football shirt in the wishlist",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "team": { "type": "string" },
        "season": { "type": "string" },
        "type": { "type": "string" },
        "brand": { "type": "string" },
        "estimatedPrice": { "type": "number" },
        "priority": { "type": "string" },
        "status": { "type": "string" },
        "referenceLink": { "type": "string" },
        "notes": { "type": "string" },
        "imageUrls": {
          "type": "array",
          "items": { "type": "string" }
        },
        "imageBgColor": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["userId", "team", "season", "type", "brand", "estimatedPrice", "priority", "status", "createdAt"]
    }
  },
  "firestore": {
    "/shirts/{shirtId}": {
      "schema": { "$ref": "#/entities/Shirt" },
      "description": "Collection of football shirts"
    },
    "/wishlist/{wishlistId}": {
      "schema": { "$ref": "#/entities/WishlistShirt" },
      "description": "Collection of wishlist shirts"
    }
  }
}
